# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
PGHOST=localhost
PGPORT=5432
PGUSER=username
PGPASSWORD=password
PGDATABASE=database_name

# Sleeper Sync Configuration
USE_SLEEPER_SYNC=false
APP_BASE_URL=http://127.0.0.1:5000

# External API Keys
FANTASYPROS_API_KEY=your_fantasypros_api_key_here
MSF_USERNAME=your_mysportsfeeds_username
MSF_PASSWORD=your_mysportsfeeds_password
SPORTSDATA_API_KEY=your_sportsdata_api_key_here

# TIBER-Forecast IRRIS integration (model inference; fail-closed if enabled but unconfigured)
FORECAST_IRRIS_ENABLED=1
FORECAST_IRRIS_BASE_URL=http://127.0.0.1:3000
FORECAST_IRRIS_API_KEY=your_forecast_api_key_here
FORECAST_IRRIS_TIMEOUT_MS=5000

# Session Configuration
SESSION_SECRET=your_session_secret_here

# Application Configuration
NODE_ENV=development
PORT=5000
TIBER_SEASON=2026

# Runtime surface. Leave unset (or use "full") for the existing application.
# Use "public-draft-review" only for the separately approved public deployment;
# it does not load database-backed/private routers, migrations, sync, or cron.
TIBER_RUNTIME_PROFILE=full

# Vite client flags (must use VITE_ prefix)
VITE_REDRAFT_READY=true

# TIBER-Data promoted player ownership artifacts (read-only)
PLAYER_OWNERSHIP_ENABLED=1
PLAYER_OWNERSHIP_LATEST_ARTIFACT_PATH=../TIBER-Data/exports/promoted/player_ownership/player_ownership_latest.json
PLAYER_OWNERSHIP_EVENTS_DIR=../TIBER-Data/exports/promoted/player_ownership/events

# Test Configuration (for CI)
SLEEPER_USERNAME=your_sleeper_username_for_testing
SLEEPER_USER_ID=your_sleeper_user_id_for_testing
SLEEPER_LEAGUE_ID=your_sleeper_league_id_for_testing
